; ============================================================================
;  配置模板：复制成 config.ini 再填自己的值
;  【重要】config.ini 含账号密码与各种 token，已被 .gitignore 忽略，
;          千万不要提交到公开仓库（本文件是脱敏模板，可以提交）。
; ============================================================================

[common]
use_cookies=false
username = 
password = 
course_list =
speed = 1
jobs = 8
notopen_action = retry

; ---- 考试作答（整卷模式需要的一个入口参数）----
; 考试走「整卷模式」时，入口 URL 里必须带 openc。它不在开考接口的返回里，
; 但就明明白白写在浏览器的考试页地址栏里，形如：
;   https://mooc1.chaoxing.com/exam-ans/mooc2/exam/preview?...&openc=0db83d1385b675201fc5f7527b80a8c4&...
; 把 ?openc= 后面那串复制到这里即可（每次开考可能不同）：
exam_openc =

; ---- 考试作答（可选，默认关闭；开启前请看下面这段说明）----
; 【使用说明】
;   · 它会替你进考场、用题库链逐题作答：第 2 档只保存答案（你自己交卷），
;     第 3 档答完并自动交卷（覆盖率达标才交）。
;   · 前提一：先用「只体检」确认这场考试现在能考（别卡在章节任务点门槛上）。
;   · 前提二：进考场就开始计时、通常只有一次机会，所以第一次请用第 2 档，
;     由程序答题、你核对后再交卷。
;   · 已知限制：整卷模式（一页显示全部题）的考试需要 openc 才能保存，该值只在
;     浏览器考试页 URL 里（?openc=…），填到上面的 exam_openc；这类考试更推荐
;     直接用浏览器里的答题脚本。
;   · 成本：命中本地 cache.json / answer_key.json 的题目不消耗任何题库额度。
;   · 每场考试都会消耗一次机会、进考场就开始计时，所以默认**一场跑完就停**，
;     不会自动接着考下一门（要一次处理多场就把下面调大，风险自负）。
exam_take_max = 1

; ---- 考试门槛等待（一体化：不让"服务端统计没汇总到"逼你再启动一次）----
; 实测（2026-09-15）：刷完课，进度页**立刻**显示 100%，但紧接着进考场却被拒
;   「该考试教师已设置章节任务点未完成90%，不能参加考试」；
; 过一会再体检，同一场考试变成 √ 可以考试。
; → 进度页是实时的，考试门槛读的是**服务端任务点聚合缓存**，汇总有几分钟到几十分钟延迟。
; 所以被这种门槛拦下时，程序会**自己重新探测门槛**（拿门槛当探测最准），
; 追上了就自动接着考，不需要人再启动一次。
;
; 最长等待秒数（默认 30 分钟）。设 0 = 不等待，遇到门槛直接跳过（退回旧行为）。
exam_gate_wait = 1800
; 等待期间每隔多少秒重新探测一次门槛（默认 2 分钟；最小 10 秒）
exam_gate_poll = 120
; 注意：只有「任务点/章节完成度没到」这类**会自己好**的原因才等；
;       已交卷 / 已过期 / 要人脸 / 认不出的原因一律不等（等多久都没用）。

; ---- 考试看板 ----
; 每次运行都会列出所有课程的考试、状态和截止倒计时，并写进日志/控制台；
; 配了通知渠道（[notification] 段的 url）时还会推送到手机。
exam_watch = true
; 剩余时间不足这么多小时时，每次运行都重复提醒（并标 ⚠）
exam_warn_hours = 48

; ============================================================
;  多账号（可选）
;  一行一个账号，格式：手机号 = 密码
;    · 只写一组 → 直接用这组登录（不会问你）
;    · 写两组以上 → 启动时列出让你选
;    · 这一整段留空或删掉 → 用上面 [common] 里的 username/password
;  key 是手机号、value 是密码，所以密码里含逗号/冒号/等号都不影响。
;  密码是明文，别把这个文件发给别人（发布脚本会自动跳过这一段）。
;  ⚠ 注意：这里配了账号就会**优先于** [common] 里的 username/password。
; ============================================================
[accounts]
# 13000000000 = 你的密码    ; <- 已移除，请自己填
# 13000000000 = 你的密码    ; <- 已移除，请自己填
# 13000000000 = 你的密码    ; <- 已移除，请自己填
# 13000000000 = 你的密码    ; <- 已移除，请自己填
# 13000000000 = 你的密码    ; <- 已移除，请自己填

[tiku]
; ============================================================
;  查询顺序（2026-09-12 两轮实测后定稿：质量优先）
;
;  【实测一 · 速度】同一批新题，两边各答一遍：
;      ANEVOL 题库 20~42 秒/题     直连 DeepSeek 0.5~2 秒/题
;      单看速度，AI 快 65 倍。
;
;  【实测二 · 准确率】中国商贸文化期末考试 85 题（拿批改页的每题得分对日志来源）：
;      ANEVOL 题库   27 题  失分 0  准确率 100%
;      本地缓存       5 题  失分 0  准确率 100%
;      AI 大模型     53 题  失分 16 准确率 70%
;      全部 16 道失分题都由 AI 答的 —— 题库在真实考卷上明显更准。
;
;  【为什么敢让题库排在前面】考试限时 100 分钟、85 题 = **每题 70 秒预算**，
;  题库的 20~42 秒完全放得下（85 题约 40 分钟）。之前觉得它慢，
;  是因为链路里还叠着网课小工具的 15 秒超时 —— 把那个去掉之后并不慢。
;
;  网课小工具已从链路移除：命中率只有 3.5%，却留下 473 次「未收录」和每题 15 秒白等。
;
;  本地缓存永远最先查，命中不花任何钱、不走网络；「正确答案库」answer_key.json
;  优先级更高（只有已核验的答案才进得去）。
; ============================================================
;
;  【想换回速度优先】provider = TikuAnevol,AI
;  并把 api/exam_take.py 里 tune_tiku_for_exam 的 anevol 超时压回 6 秒。
; ============================================================
provider = AI,TikuAnevol

; ---------- 网课小工具题库（GO题）----------
; 接口地址，留空会自动用这个默认值
icodef_url = https://cx.icodef.com/wyn-nb?v=4
; 官方限制「1 并发」，程序内部已强制串行；这里是两次请求之间的最小间隔（秒）。
; 实测 0.3 秒太激进：8 个 worker 同时开章节时会打出突发请求，
; 服务端仍会返回 code=-2「触发流控限制: 1并发限制」（实测 20 次请求里 5 次中招，每次白等 2 秒）。
; 调到 1.5 秒后突发被摊平，基本不再触发。若还偶发，可继续往上调（2、3），无需重新打包。
icodef_min_interval = 1.5
; 读超时（秒）
icodef_timeout = 15
; 可选：填了会带上 Authorization 请求头（不填=不带，公开接口够用）
icodef_authorization = 

; ---------- ANEVOL 题库 ----------
; ANEVOL 接口地址（留空也会自动用这个默认值）
url = https://tiku.anevol.cn/api/search
; ANEVOL token，多个用英文逗号分隔（只用第一个）
tokens = 
; ANEVOL 请求最小间隔（秒），别调太小，容易被限流
anevol_min_interval = 0.3

; 达到覆盖率后自动提交（true=答完就交；false=只保存不提交）
submit = true

; 最低题库覆盖率（搜到的题占总题数的比例）
cover_rate = 0.8

; 每道题之间的间隔（秒）
delay = 1.5

; 判断题匹配规则（内置实现会把题库的判断题答案归一化成“正确/错误”）
true_list = 正确,对,√,是
false_list = 错误,错,×,否,不对,不正确

; ---- AI 兜底（第三道防线，DeepSeek）----
; 【必须填 key，留空的话 AI 会被自动跳过，并在日志里明确提示“AI 兜底未配置完整”】
; 申请地址：https://platform.deepseek.com/api_keys   （充值几块钱能用很久）
endpoint = https://api.deepseek.com/v1
key = 
;
; ⚠️ model 必须写**API 认的名字**，不是网页/客户端里显示的版本名：
;      API 名            版本名（客户端显示）        正确率   每题约
;      deepseek-flash    DeepSeek-V4.1-Flash        75%     ¥0.0017
;      deepseek-v4-pro   DeepSeek-V4-Pro-0813        95%     ¥0.0045
;    查当前可用列表：GET https://api.deepseek.com/v1/models
;
; 【踩过的坑】这里以前写的是 `deepseek-chat` —— 那个名字 API **根本不认**，
; 请求会被静默回退到最弱的 flash，于是正确率一直是 75% 左右，
; 而日志里看不出任何异常（2026-09-15 实测：同一批题 flash 75% / v4-pro 95%）。
; 按官方文档，`deepseek-v4-flash`、`deepseek-v4-flash-vision-exp` 这些旧名字
; 仍被接受，但对应模型已退役、实际仍由 V4.1-Flash 服务 —— 所以别指望换个旧名就能升档。
model = deepseek-flash

; ---- 思考模式（其实是最大的省钱开关，2026-09-21 实测）----
; 官方文档：DeepSeek 的 thinking 模式默认开启、默认强度 high。
; 实测账单 18:00~19:00 共 44,678 tokens，其中输出 42,233（94.5%）——
; 全是每道题的"思考过程"，而输出单价是输入的 4 倍。所以"贵"不是缓存问题（未命中输入只占 5.5%）。
;
; 同一道单选题实测（正确答案 = LEXIS系统，来自实际批改记录）：
;     thinking=enabled   5.9s   输入119  输出 846   -> DATUM系统  X
;     thinking=low       6.1s   输入119  输出1020   -> DATUM系统  X   (low 反而更多，没有中间档)
;     thinking=disabled  0.8s   输入 94  输出   9   -> LEXIS系统  OK  (输出 1/100，速度快 7 倍)
;
;       先按 disabled 用；若发现错的变多，把下面改成 enabled 即可。
; 准确率 A/B（2026-09-21：cache 里题库验证过的判断题抽 30 条、固定随机种子，
; 同批题同管道只改 thinking）：
;     enabled(high)  正确 24/30 = 80.0%   输出 369 tokens/题   3.77s/题
;     disabled       正确 26/30 = 86.7%   输出   7 tokens/题   2.92s/题
;   -> 关掉思考三个指标全赢（更准、输出省 53 倍、更快），所以默认 disabled。
; 标尺是题库的答案，而题库本身也有错的（如「毕加索曾经仿过齐白石的画」
; 题库判"错误"，但历史上毕加索确实临摹过齐白石）——真实准确率可能更高。
thinking = disabled
; enabled 时生效的思考强度：low / high / max（官方默认 high）
reasoning_effort = low

; 多选题的解法（2026-09-15 新增）
;   per_option（默认）逐项判断：把一道多选拆成 N 个独立的是非判断，再把判"对"的合起来
;   all                一次性问（旧行为：让模型一次吐出所有正确项）
;
; 【为什么默认改成 per_option】实考 85 题按题型拆开：
;     单选 35/40 = 87.5%    判断 26/30 = 86.7%    **多选 22/30 = 73.3%**
;   多选是明显短板。用项目自己的管道在同一批判断题上实测 flash 90% / v4-pro 95%，
;   说明模型和管道都正常 —— 问题在"一次吐出所有正确项"这种问法容易漏选或多选。
; 代价：多选题每个选项一次请求（4 个选项 = 4 次），cache 命中的题不花钱。
; 逐项判断失败、或判"对"的少于 2 个（多选题至少两个正确项）时会自动退回
; 一次性问法，不会卡住也不会硬编一个可疑答案。
multi_choice_mode = per_option
; AI 请求最小间隔（秒），防止 8 个 worker 同时答题把接口打爆
min_interval_seconds = 3
; 可选：需要走代理时填，例如 http://127.0.0.1:7890，不需要留空
http_proxy =

; ---- 以下为其它内置题库专用，用上面这套时全部留空 ----
likeapi_search = false
likeapi_model =
siliconflow_key = 
siliconflow_model =
siliconflow_endpoint =

[notification]
provider = ServerChan
url =
tg_chat_id = XXXXXX